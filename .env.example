APP_ENV=development
DATABASE_URL=sqlite:///./yunguo.db
# Generate independently: openssl rand -hex 32 (at least 32 characters each)
JWT_SECRET=replace-with-independent-random-jwt-secret
CODE_PEPPER=replace-with-independent-random-card-pepper
REDIS_URL=
DEMO_RECHARGE_ENABLED=true
FULFILLMENT_MODE=mock
MOCK_DIRECT_TOPUP_ENABLED=false
FULFILLMENT_PROVIDER_URL=
FULFILLMENT_PROVIDER_TOKEN=
FULFILLMENT_WEBHOOK_SECRET=
CORS_ORIGINS=["http://localhost:5173"]
# Docker Compose requires these; do not reuse placeholder values in production.
POSTGRES_PASSWORD=replace-with-random-database-password
# Initialization CLI reads these only; never creates an administrator automatically.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional email recovery. No external emails sent until enabled and configured.
PASSWORD_RESET_ENABLED=false
PUBLIC_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
PASSWORD_RESET_MINUTES=20

# Optional registration email ownership verification (shares SMTP configuration).
EMAIL_VERIFICATION_ENABLED=false
REQUIRE_VERIFIED_EMAIL_FOR_PURCHASE=false
EMAIL_VERIFICATION_MINUTES=60

# Persistent in-site alerts and worker heartbeats; no external messages
MONITOR_ENABLED=true
MONITOR_INTERVAL_SECONDS=15
WORKER_HEARTBEAT_SECONDS=10
WORKER_STALE_SECONDS=60
MONITOR_STALE_MINUTES=30
